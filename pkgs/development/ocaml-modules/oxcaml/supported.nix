# The attributes of `ocamlPackages_oxcaml` that are actually known to work.
#
# The scope inherits ~1250 package definitions from
# pkgs/top-level/ocaml-packages.nix, and the vast majority of them have never
# been built against OxCaml. Everything *not* named here still resolves and
# still builds, but warns first -- see the guard in
# pkgs/top-level/ocaml-packages.nix, which reads this file.
#
# This list mirrors the "Known to build" section of ./README.md; update both
# together. A name here that is not in the scope is an eval error, so typos and
# renames are caught rather than silently leaving a package unguarded.
#
# If you build something not on this list and it works, add it -- that is the
# intended way for this list to grow.
[
  # Scope machinery synthesised by lib.makeScope, plus the compiler and the
  # builders a consumer needs to define packages of their own against this
  # scope. Not derivations, and not optional: dropping any of them would make
  # the bare attribute reference warn.
  "callPackage"
  "newScope"
  "overrideScope"
  "packages"
  "ocaml"
  "buildDunePackage"
  "buildOasisPackage"
  "buildTopkgPackage"
  "janePackage"
  # The full v0.18 Jane Street set. Deliberately reachable in one piece: it is
  # a single coherent export from the upstream `oxcaml` branches, so
  # janeStreet.<pkg> is left unguarded even for the packages not listed below.
  "janeStreet"

